{
  "compilerOptions": {
    "target": "ES6",
    "module": "commonjs",           // ← Cambiar esto
    "rootDir": "./src",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "outDir": "./dist",
    "esModuleInterop": true,
    "baseUrl": "./",
    "strict": true,
    "skipLibCheck": true,
     "paths": {
      "*": ["src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "**/*.spec.ts"]
}